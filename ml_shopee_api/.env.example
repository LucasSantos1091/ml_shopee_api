# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).
# NUNCA cole essas credenciais em chat, issue, print ou log.

# ---------------------------------------------------------------------------
# Mercado Livre (https://developers.mercadolivre.com.br)
# Crie uma aplicacao em https://developers.mercadolivre.com.br/apps/
# ---------------------------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser EXATAMENTE igual ao cadastrado na aplicacao (https obrigatorio em producao)
ML_REDIRECT_URI=https://localhost:8443/ml/callback
ML_SITE_ID=MLB

# ---------------------------------------------------------------------------
# Shopee Open Platform (https://open.shopee.com)
# Crie um app em https://open.shopee.com -> Manage Apps
# ---------------------------------------------------------------------------
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://localhost:8443/shopee/callback
# "test" usa o ambiente sandbox (partner.test-stable.shopeemobile.com)
# "live" usa producao (partner.shopeemobile.com)
SHOPEE_ENV=test
SHOPEE_SHOP_ID=

# ---------------------------------------------------------------------------
# Shopee Affiliate API (GraphQL) - opcional, exige aprovacao separada no
# programa de afiliados da Shopee
# ---------------------------------------------------------------------------
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=

# ---------------------------------------------------------------------------
# Chave usada para CRIPTOGRAFAR os tokens salvos em disco (storage/token_store.py)
# Gere uma com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde essa chave separada do arquivo de tokens (idealmente em um secrets manager)
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=
